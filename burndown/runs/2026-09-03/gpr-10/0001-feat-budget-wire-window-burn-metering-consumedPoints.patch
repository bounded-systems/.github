+} from "./window-meter.ts";
+
+const HOUR = 3_600_000;
+// A fixed clock: 2026-06-17T00:00:00Z. No Date.now() anywhere in this file.
+const T0 = Date.UTC(2026, 5, 17);
+
+const ROLLING_5H: UsageWindow = ROLLING_5H_BUDGET.window;
+const WEEKLY: UsageWindow = WEEKLY_BUDGET.window;
+
+function sample(at: number, points: number): UsageSample {
+  return { at, points };
+}
+
+Deno.test("windowStart: rolling is now minus the duration", () => {
+  assertEquals(windowStart(ROLLING_5H, T0), T0 - 5 * HOUR);
+});
+
+Deno.test("windowStart: calendar snaps to the last boundary from the anchor", () => {
+  const anchor = T0; // boundaries at T0, T0+168h, T0+336h, ...
+  assertEquals(windowStart(WEEKLY, T0, anchor), T0);
+  assertEquals(windowStart(WEEKLY, T0 + 100 * HOUR, anchor), T0);
+  assertEquals(windowStart(WEEKLY, T0 + 168 * HOUR, anchor), T0 + 168 * HOUR);
+  assertEquals(
+    windowStart(WEEKLY, T0 + 500 * HOUR, anchor),
+    T0 + 336 * HOUR,
+  );
+  // Default anchor is the Unix epoch: boundaries every 168h from 0.
+  assertEquals(windowStart(WEEKLY, T0) % (168 * HOUR), 0);
+});
+
+Deno.test("consumedPoints: rolling window accumulates, then slides samples out", () => {
+  const samples = [
+    sample(T0, 1),
+    sample(T0 + 1 * HOUR, 2),
+    sample(T0 + 2 * HOUR, 3),
+  ];
+  // Burn accumulates as the window fills.
+  assertEquals(consumedPoints(ROLLING_5H, samples, T0), 1);
+  assertEquals(consumedPoints(ROLLING_5H, samples, T0 + 1 * HOUR), 3);
+  assertEquals(consumedPoints(ROLLING_5H, samples, T0 + 2 * HOUR), 6);
+  // Still all inside at exactly 5h after the first sample (inclusive start).
+  assertEquals(consumedPoints(ROLLING_5H, samples, T0 + 5 * HOUR), 6);
+  // The first sample ages out, then the second, then the window is empty.
+  assertEquals(consumedPoints(ROLLING_5H, samples, T0 + 5 * HOUR + 1), 5);
+  assertEquals(consumedPoints(ROLLING_5H, samples, T0 + 6 * HOUR + 1), 3);
+  assertEquals(consumedPoints(ROLLING_5H, samples, T0 + 7 * HOUR + 1), 0);
+});
+
+Deno.test("consumedPoints: calendar window accumulates and resets at the boundary", () => {
+  const anchor = T0;
+  const boundary = T0 + 168 * HOUR;
+  const samples = [
+    sample(T0 + 1 * HOUR, 4),
+    sample(T0 + 50 * HOUR, 6),
+    sample(T0 + 167 * HOUR, 5), // last minute of week 1
+    sample(boundary, 2), // first instant of week 2 — belongs to week 2
+    sample(boundary + 3 * HOUR, 7),
+  ];
+  // Week 1 accumulates.
+  assertEquals(consumedPoints(WEEKLY, samples, T0 + 2 * HOUR, anchor), 4);
+  assertEquals(consumedPoints(WEEKLY, samples, T0 + 60 * HOUR, anchor), 10);
+  assertEquals(
+    consumedPoints(WEEKLY, samples, boundary - 1, anchor),
+    15,
+  );
+  // At the boundary the count resets: only week-2 samples count.
+  assertEquals(consumedPoints(WEEKLY, samples, boundary, anchor), 2);
+  assertEquals(consumedPoints(WEEKLY, samples, boundary + 4 * HOUR, anchor), 9);
+  // And a fresh week 3 starts from zero again.
+  assertEquals(
+    consumedPoints(WEEKLY, samples, boundary + 168 * HOUR, anchor),
+    0,
+  );
+});
+
+Deno.test("consumedPoints: future samples never count, order is irrelevant", () => {
+  const samples = [
+    sample(T0 + 3 * HOUR, 100), // in the future relative to `now`
+    sample(T0 + 1 * HOUR, 2),
+    sample(T0, 1),
+  ];
+  assertEquals(consumedPoints(ROLLING_5H, samples, T0 + 1 * HOUR), 3);
+  assertEquals(consumedPoints(WEEKLY, samples, T0 + 1 * HOUR, T0), 3);
+});
+
+Deno.test("consumedPoints: empty ledger is zero burn", () => {
+  assertEquals(consumedPoints(ROLLING_5H, [], T0), 0);
+  assertEquals(consumedPoints(WEEKLY, [], T0), 0);
+});
+
+Deno.test("unitsToPoints: inverse of the budget's conversion", () => {
+  assertEquals(unitsToPoints(100_000, ROLLING_5H_BUDGET.conversion), 2);
+  assertEquals(unitsToPoints(25_000, ROLLING_5H_BUDGET.conversion), 0.5);
+  assertEquals(unitsToPoints(1, { unit: "tokens", unitPerPoint: 0 }), 0);
+});
+
+Deno.test("meterBudget: feeds the windowed burn into planCapacity", () => {
+  const samples = [sample(T0, 4), sample(T0 + 1 * HOUR, 4)];
+  const report = meterBudget(ROLLING_5H_BUDGET, samples, T0 + 2 * HOUR);
+  assertEquals(report.consumedPoints, 8);
+  assertEquals(report.remainingPoints, 2);
+  assertEquals(report.status, "at-risk"); // 8/10 = 0.8 >= AT_RISK_THRESHOLD
+  // Six hours on, both samples have aged out of the 5h window.
+  const later = meterBudget(ROLLING_5H_BUDGET, samples, T0 + 7 * HOUR);
+  assertEquals(later.consumedPoints, 0);
+  assertEquals(later.status, "ok");
+});
