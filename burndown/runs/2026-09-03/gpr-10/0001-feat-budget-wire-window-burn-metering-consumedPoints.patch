diff --git a/window-meter.ts b/window-meter.ts
new file mode 100644
index 0000000..f6d112f
--- /dev/null
+++ b/window-meter.ts
@@ -0,0 +1,105 @@
+/**
+ * @module
+ * Window-burn metering — turns a ledger of timestamped usage samples into the
+ * `consumedPoints` that `planCapacity()` / `budgetGate()` need (#10).
+ *
+ * The prioritization contract deliberately leaves the meter out: it judges a
+ * budget given a measured burn but does not measure. This module is the pure
+ * half of that measurement — given samples and a clock, how much of the
+ * budget's CURRENT window has been spent? It is deterministic (the clock is a
+ * parameter, never `Date.now()`), dependency-free, and does no I/O; the ledger
+ * adapter that reads samples from disk / telemetry lives in `budget-check.ts`.
+ *
+ * Window semantics (see `UsageWindow` in prioritization.ts):
+ *   - `rolling`  — the window is the last `durationHours` ending at `now`;
+ *                  samples slide out as they age past the duration.
+ *   - `calendar` — fixed, back-to-back windows of `durationHours` anchored at
+ *                  `anchor` (epoch ms, default 0 = the Unix epoch); the count
+ *                  resets to zero at every boundary.
+ * In both cases a sample counts when `windowStart <= at <= now`. Samples in the
+ * future (`at > now`) never count — a clock-skewed emitter cannot pre-spend the
+ * window.
+ */
+
+import {
+  type Budget,
+  type CapacityReport,
+  type ConversionMapping,
+  type EffortPoints,
+  planCapacity,
+  type PriorityInput,
+  type UsageWindow,
+} from "./prioritization.ts";
+
+/** One metered spend event: `points` of effort burned at instant `at`. */
+export interface UsageSample {
+  /** When the spend happened, epoch milliseconds. */
+  readonly at: number;
+  /** Effort burned, in abstract points (see `unitsToPoints` for meters). */
+  readonly points: EffortPoints;
+}
+
+const HOUR_MS = 3_600_000;
+
+/** Convert concrete metered units (e.g. tokens) back into effort points. */
+export function unitsToPoints(
+  units: number,
+  mapping: ConversionMapping,
+): EffortPoints {
+  return mapping.unitPerPoint > 0 ? units / mapping.unitPerPoint : 0;
+}
+
+/**
+ * The instant the current window opened, epoch ms.
+ *   - rolling:  `now - durationHours`.
+ *   - calendar: the most recent boundary at or before `now`, where boundaries
+ *               sit every `durationHours` from `anchor` (default epoch 0).
+ */
+export function windowStart(
+  window: UsageWindow,
+  now: number,
+  anchor = 0,
+): number {
+  const span = window.durationHours * HOUR_MS;
+  if (window.kind === "rolling") return now - span;
+  if (span <= 0) return now;
+  return anchor + Math.floor((now - anchor) / span) * span;
+}
+
+/**
+ * Sum the samples that fall inside the current window: `windowStart <= at <=
+ * now`. Order of `samples` does not matter; samples outside the window (aged
+ * out of a rolling window, before the last calendar boundary, or in the
+ * future) contribute nothing.
+ */
+export function consumedPoints(
+  window: UsageWindow,
+  samples: readonly UsageSample[],
+  now: number,
+  anchor = 0,
+): EffortPoints {
+  const start = windowStart(window, now, anchor);
+  let total = 0;
+  for (const s of samples) {
+    if (s.at >= start && s.at <= now) total += s.points;
+  }
+  return total;
+}
+
+/**
+ * `planCapacity()` with the live-burn axis filled in from a sample ledger —
+ * the one call a room makes to read a budget on both axes.
+ */
+export function meterBudget(
+  budget: Budget,
+  samples: readonly UsageSample[],
+  now: number,
+  plannedItems: readonly PriorityInput[] = [],
+  anchor = 0,
+): CapacityReport {
+  return planCapacity(
+    budget,
+    plannedItems,
+    consumedPoints(budget.window, samples, now, anchor),
+  );
+}
