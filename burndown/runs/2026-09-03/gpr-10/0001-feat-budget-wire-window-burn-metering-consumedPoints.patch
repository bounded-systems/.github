+/**
+ * Parse a ledger document (already read from disk) into samples for `budget`.
+ * Accepts a JSON array of `{ at, points }` / `{ at, units }` entries; `at` may
+ * be epoch ms or an ISO-8601 string. Entries that don't parse are skipped so a
+ * partially-corrupt ledger degrades to "less burn seen", never to a crash.
+ */
+export function parseLedger(json: string, budget: Budget): UsageSample[] {
+  const raw: unknown = JSON.parse(json);
+  if (!Array.isArray(raw)) return [];
+  const samples: UsageSample[] = [];
+  for (const entry of raw) {
+    if (typeof entry !== "object" || entry === null) continue;
+    const e = entry as Record<string, unknown>;
+    const at = typeof e.at === "number"
+      ? e.at
+      : typeof e.at === "string"
+      ? Date.parse(e.at)
+      : NaN;
+    if (!Number.isFinite(at)) continue;
+    const points = typeof e.points === "number"
+      ? e.points
+      : typeof e.units === "number"
+      ? unitsToPoints(e.units, budget.conversion)
+      : NaN;
+    if (!Number.isFinite(points)) continue;
+    samples.push({ at, points });
