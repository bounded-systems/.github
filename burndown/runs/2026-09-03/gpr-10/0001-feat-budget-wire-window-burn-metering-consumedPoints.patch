diff --git a/budget-check_test.ts b/budget-check_test.ts
new file mode 100644
index 0000000..d554dfe
--- /dev/null
+++ b/budget-check_test.ts
@@ -0,0 +1,88 @@
+import { assertEquals } from "@std/assert";
+import { evaluate, parseLedger } from "./budget-check.ts";
+import { ROLLING_5H_BUDGET, WEEKLY_BUDGET } from "./prioritization.ts";
+
+const HOUR = 3_600_000;
+const T0 = Date.UTC(2026, 5, 17);
+
+Deno.test("evaluate: no ledger fails open — only the static envelope is enforced", () => {
+  const ok = evaluate({ budgetId: "rolling-5h", aboutToSpend: 1, now: T0 });
+  assertEquals(ok.allow, true);
+  assertEquals(ok.exitCode, 0);
+  // The envelope itself still holds: a single item the size of the cap blocks.
+  const over = evaluate({ budgetId: "rolling-5h", aboutToSpend: 10, now: T0 });
+  assertEquals(over.allow, false);
+  assertEquals(over.exitCode, 1);
+});
+
+Deno.test("evaluate: metered burn inside the window closes the gate", () => {
+  const samples = [
+    { at: T0 - 4 * HOUR, points: 4 },
+    { at: T0 - 1 * HOUR, points: 5 },
+  ];
+  // 9 burned + 1 about to spend = 10 >= cap → block.
+  const blocked = evaluate({
+    budgetId: "rolling-5h",
+    aboutToSpend: 1,
+    samples,
+    now: T0,
+  });
+  assertEquals(blocked.allow, false);
+  assertEquals(blocked.exitCode, 1);
+  // Two hours later the 4-point sample has slid out of the 5h window → allow.
+  const later = evaluate({
+    budgetId: "rolling-5h",
+    aboutToSpend: 1,
+    samples,
+    now: T0 + 2 * HOUR,
+  });
+  assertEquals(later.allow, true);
+  assertEquals(later.exitCode, 0);
+});
+
+Deno.test("evaluate: calendar burn resets at the weekly boundary", () => {
+  const start = Math.floor(T0 / (168 * HOUR)) * 168 * HOUR; // epoch-aligned
+  const samples = [{ at: start + 1 * HOUR, points: 40 }];
+  const blocked = evaluate({
+    budgetId: "weekly",
+    aboutToSpend: 0,
+    samples,
+    now: start + 100 * HOUR,
+  });
+  assertEquals(blocked.allow, false);
+  const nextWeek = evaluate({
+    budgetId: "weekly",
+    aboutToSpend: 0,
+    samples,
+    now: start + 168 * HOUR,
+  });
+  assertEquals(nextWeek.allow, true);
+  assertEquals(WEEKLY_BUDGET.window.kind, "calendar");
+});
+
+Deno.test("evaluate: unknown budget fails open regardless of ledger", () => {
+  const d = evaluate({
+    budgetId: "nope",
+    aboutToSpend: 999,
+    samples: [{ at: T0, points: 999 }],
+    now: T0,
+  });
+  assertEquals(d.allow, true);
+  assertEquals(d.exitCode, 0);
+});
+
+Deno.test("parseLedger: points, units (via conversion), ISO timestamps; junk skipped", () => {
+  const json = JSON.stringify([
+    { at: T0, points: 2 },
+    { at: "2026-06-17T01:00:00Z", units: 100_000 }, // 2 pts at 50k tokens/pt
+    { at: "not a date", points: 5 },
+    { at: T0, nothing: 1 },
+    "garbage",
+    null,
+  ]);
+  assertEquals(parseLedger(json, ROLLING_5H_BUDGET), [
+    { at: T0, points: 2 },
+    { at: T0 + HOUR, points: 2 },
+  ]);
+  assertEquals(parseLedger("{}", ROLLING_5H_BUDGET), []);
+});
