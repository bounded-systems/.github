+/**
+ * GH-360: the headless TESTER's system prompt. Derived for the tester's real
+ * posture — read-only over a COMMITTED implementation, evidence over edits —
+ * so it can never be mistaken for the executor mandate ("execute the plan …
+ * commit the work"), which is what the pilot's testing leg used to receive.
+ */
+function buildHeadlessTesterStableSystemPrompt(): string {
+  return [
+    "You are the tester agent, running headlessly — there is no interactive approval, so any tool outside your granted allowlist simply cannot run.",
+    "Stay strictly scoped to your work unit, its current directory, and the configured tool boundaries. Do not invent or switch identities.",
+    "The executor has ALREADY implemented and committed this work unit in the current worktree. Your job is to validate that committed implementation, not to implement it: inspect the committed changes (`prx tools git log` / `prx tools git diff`), read the touched code, run the unit tests, and report the evidence.",
+    "You are read-only: do NOT edit or write source files, do NOT commit, and do NOT re-implement the plan. If the tests fail or the implementation does not match its scope, report precisely what fails and why — that is a valid, complete result.",
+    "If the test runner (`bun test`) is unavailable in your sandbox, say so explicitly and report what you could verify by inspection — never claim tests passed that you did not run.",
+    "Do NOT run `prx`, `bd`, `gh`, or raw `git` to re-derive scope or inspect the model — they are intentionally outside your headless toolset (the `prx tools git` read wrappers are the exception). Read the codebase directly with Read/Grep/Glob instead.",
+  ].join(" ");
+}
+
+/**
+ * GH-360: headless TEST profile — the pilot's `testing` leg. The tester and
+ * the executor share the `implement` session (same worktree, so the tests run
+ * against the executor's commit), but they are DIFFERENT roles with different
+ * authority: this profile is the SDK counterpart of
+ * `buildWorkUnitClaudeImplementSdkRuntimeProfile` with a tester identity
+ * (`PRX_AGENT_ROLE=tester`), a read-only + test-runner allowlist (Edit/Write
+ * denied), and a prompt that consumes the COMMITTED implementation rather than
+ * re-executing the draft plan.
+ *
+ * Before this existed the testing leg was served the executor profile + plan,
+ * re-implemented the unit, reported "done", and looped the pilot through
+ * executing→checking→testing until the retreat budget was spent (GH-360).
+ */
+export function buildWorkUnitClaudeTestSdkRuntimeProfile(input: {
+  workUnitId: string;
+  planPath?: string | undefined;
+  /**
+   * The consumed `<unit>:plan@draft` body — CONTEXT for the tester (what the
+   * implementation was supposed to do), never its scope of work.
+   */
+  planBody?: string | undefined;
+}): RuntimeProfileProjection {
+  const role: TaskAgentRole = "tester";
+  const systemPromptStable = buildHeadlessTesterStableSystemPrompt();
+  const dynamicSegments = [buildWorkUnitDynamicSystemSegment(input.workUnitId)];
+  if (input.planPath) {
+    dynamicSegments.push(`The plan the implementation was built from is at ${input.planPath}.`);
+  }
+  const systemPromptDynamic = dynamicSegments.join(" ");
+  const systemPrompt = `${systemPromptStable} ${systemPromptDynamic}`;
+  const userPrompt = [
+    `Test the committed implementation of ${input.workUnitId} in this worktree.`,
+    "Inspect the commit, run the unit tests that cover the changed code, and report pass/fail with evidence. Do not edit files, do not commit, do not ask clarifying questions.",
+    ...(input.planBody
+      ? [
+          "",
+          "For context only, the plan the implementation was built from is reproduced below. Verify the implementation against it; do NOT execute it.",
+          "",
+          "----- BEGIN PLAN (CONTEXT) -----",
+          input.planBody,
+          "----- END PLAN (CONTEXT) -----",
+        ]
+      : []),
+  ].join("\n");
+  // Read-only base + the test runner + the read-side git wrapper. The reader
+  // posture denies Edit/Write; SHARED_DENY keeps raw git/gh/bd out of reach.
+  // `omitOwnNamespace: true` — the tester must NOT inherit `Bash(prx implement:*)`
+  // (the actor's own-namespace glob), because that would re-admit
+  // `prx implement agent`, i.e. let the tester launch the very executor run
+  // this profile exists to replace (same hazard as `submit`, see above).
+  const { allowedTools, disallowedTools } = actorRuleset("implement", {
+    role: "reader",
+    omitOwnNamespace: true,
+    extraAllow: ["Bash(bun test:*)", "Bash(bun run:*)", "Bash(prx tools git:*)"],
+  });
+  const args = [
+    "--print",
+    "--output-format",
+    "json",
+    "--setting-sources",
+    "project,local",
+    "--permission-mode",
+    "acceptEdits",
+    "--allowedTools",
+    allowedTools.join(","),
+    "--disallowedTools",
+    disallowedTools.join(","),
+    "--append-system-prompt",
+    systemPrompt,
+    userPrompt,
+  ];
+
+  return {
+    profile: "work-unit",
+    mode: "dev",
+    command: "claude",
+    args,
+    env: {
+      PRX_AGENT_ROLE: role,
+      ...agentOtelEnv(role),
+    },
+    agentRuntime: "sdk",
+    interaction: "headless",
+    sdkSpec: {
+      prompt: userPrompt,
+      systemPromptStable: [systemPromptStable],
+      systemPromptDynamic: [systemPromptDynamic],
+      // prx-hz1: headless runs never use `plan` mode (it blocks on an approval
+      // that never comes). The allow/deny lists are the authority boundary.
+      permissionMode: "acceptEdits",
+      allowedTools,
+      disallowedTools,
+      strictMcpConfig: true,
+      settingSources: ["project", "local"],
+    },
+    trustTiers: {
+      tierA_controlled: [
+        "project cwd",
+        `${role} system prompt`,
+        "tester allowlist",
+        "project MCP config",
+      ],
+      tierB_partial: ["user-scoped MCP entries"],
+      tierC_ambient: ["claude.ai connectors", "built-in agents"],
+    },
+    sourcesOfTruth: {
+      agents: "inline_prompt",
+      mcp: "project-only",
+      plugins: ["beads", "worktrunk"],
+      connectors: [],
+    },
+    allowedActors: [...workUnitAllowedActors],
+    disallowedActors: [...workUnitDisallowedActors],
+    notes: [
+      `Headless ${role} surface: the pilot's testing leg (GH-360). Runs in the implement worktree against the executor's commit; read-only + test runner.`,
+      "Edit/Write are denied and raw git/gh/bd stay behind SHARED_DENY; the tester reports evidence, it never re-implements.",
+    ],
+  };
+}
