+// GH-360: the pilot's testing leg. The tester shares the executor's implement
+// worktree but is a different role with a different (read-only) authority and
+// a prompt that consumes the COMMITTED implementation — it must never be the
+// executor profile + plan the leg used to be served.
+describe("buildWorkUnitClaudeTestSdkRuntimeProfile (GH-360)", () => {
+  test("is a headless SDK profile with the TESTER identity", () => {
+    const p = buildWorkUnitClaudeTestSdkRuntimeProfile({ workUnitId: "GH-360" });
+    expect(p.command).toBe("claude");
+    expect(p.interaction).toBe("headless");
+    expect(p.agentRuntime).toBe("sdk");
+    expect(resolveAgentBackend(p)).toBe("sdk");
+    expect(p.env?.PRX_AGENT_ROLE).toBe("tester");
+    expect(p.sdkSpec?.permissionMode).toBe("acceptEdits"); // prx-hz1: headless never uses plan mode
+  });
+
+  test("is read-only + test runner: Edit/Write denied, bun test + git-read wrapper allowed", () => {
+    const p = buildWorkUnitClaudeTestSdkRuntimeProfile({ workUnitId: "GH-360" });
+    const allowed = p.sdkSpec?.allowedTools ?? [];
+    const denied = p.sdkSpec?.disallowedTools ?? [];
+    expect(allowed).not.toContain("Edit");
+    expect(allowed).not.toContain("Write");
+    expect(denied).toContain("Edit");
+    expect(denied).toContain("Write");
+    expect(allowed).toContain("Read");
+    expect(allowed).toContain("Bash(bun test:*)");
+    expect(allowed).toContain("Bash(prx tools git:*)");
+    // The tester must not inherit the implement actor's own-namespace glob:
+    // `Bash(prx implement:*)` would re-admit `prx implement agent`, i.e. let
+    // the tester re-launch the executor it is supposed to be validating.
+    expect(allowed).not.toContain("Bash(prx implement:*)");
+    expect(allowed.some((tool) => tool.startsWith("Bash(prx implement"))).toBe(false);
+    // Raw git/gh/bd stay behind the shared deny.
+    expect(denied).toContain("Bash(git:*)");
+    expect(denied).toContain("Bash(gh:*)");
+    // And it is NOT the executor's allowlist.
+    expect(allowed).not.toEqual([...SESSION_PROFILES.implement.allowedTools]);
+  });
+
+  test("prompt consumes the committed implementation; the plan is context, not scope", () => {
+    const planBody = "## Scope\nUpdate the README only.";
+    const p = buildWorkUnitClaudeTestSdkRuntimeProfile({ workUnitId: "GH-360", planBody });
+    const prompt = p.sdkSpec?.prompt ?? "";
+    expect(prompt).toContain("Test the committed implementation of GH-360");
+    expect(prompt).toContain("BEGIN PLAN (CONTEXT)");
+    expect(prompt).toContain("Update the README only.");
+    expect(prompt).toContain("do NOT execute it");
+    expect(prompt).not.toContain("BEGIN APPROVED PLAN");
+    expect(prompt).not.toContain("commit the work");
+    const sys = p.sdkSpec?.systemPromptStable?.join(" ") ?? "";
+    expect(sys).toContain("You are the tester agent");
+    expect(sys).toContain("ALREADY implemented and committed");
+    expect(sys).not.toContain("You are the executor agent");
+    // Cache-stable prefix carries no per-unit plan body.
+    expect(sys).not.toContain("Update the README only.");
+  });
