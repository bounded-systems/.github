+ * The default is the live trio (dolt sql, gh, rate_limit); callers pass nothing.
+ */
+export interface DeltaIo {
+  readonly sql: (query: string) => Promise<string>;
+  readonly gh: (args: readonly string[]) => Promise<string>;
+  readonly graphqlLimit: () => Promise<GraphqlLimit>;
+}
+
