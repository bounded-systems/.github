@@ -0,0 +1,14 @@
+---
+"@bounded-systems/prx": patch
+---
+
+Fully qualify the claude-room image. `claudeRoom.image` was the bare
+`claude-box`, so `prx pod up --pod per-repo` rendered `image: "claude-box"`
+into the kube-play manifest and podman expanded it against Docker Hub
+(`docker.io/library/claude-box:latest` → 404) on any host without a local
+image (bounded-systems/claude-box#245). The room now pins the published
+`ghcr.io/bounded-systems/claude-box/claude-room:0.7.0`, exported as
+`CLAUDE_ROOM_IMAGE` alongside the sibling `*_ROOM_IMAGE` constants. The GHCR
+package is private today, so a fresh host still needs `podman login ghcr.io`
+(a token with `read:packages`) before the pull succeeds; a digest pin can
+replace the tag once the digest is readable.
diff --git a/packages/prx/src/room/claude-room.ts b/packages/prx/src/room/claude-room.ts
index 17e702d..6d39b9b 100644
--- a/packages/prx/src/room/claude-room.ts
+++ b/packages/prx/src/room/claude-room.ts
@@ -23,10 +23,25 @@ import type { RoomSpec } from "./spec.ts";
 
 const DOORS = "/run/prx/doors";
 
+/**
+ * The claude-box runtime image that fills the room (prx-d4o), published by
+ * `bounded-systems/claude-box`'s publish-ghcr workflow as
+ * `ghcr.io/bounded-systems/claude-box/claude-room:<release>` (nix attr
+ * `claude-image` → GHCR name `claude-room`). Fully qualified on purpose: a bare
+ * `claude-box` made podman expand the kube-play default against Docker Hub
+ * (`docker.io/library/claude-box:latest` → 404) on any host without a local
+ * image (claude-box#245). Pinned to a release tag, not a digest — the GHCR
+ * package is private today, so `podman login ghcr.io` (a token with
+ * `read:packages`) is still required to pull; see claude-box's HOSTING.md.
+ * Bump when claude-box releases; switch to `@sha256:…` (and add it to
+ * `BOX_PINS` in repin.ts) once the digest is readable.
+ */
+export const CLAUDE_ROOM_IMAGE = "ghcr.io/bounded-systems/claude-box/claude-room:0.7.0";
+
 export const claudeRoom: RoomSpec = {
   name: "claude-room",
   // The room is filled by the claude-box runtime image (prx-d4o).
-  image: "claude-box",
+  image: CLAUDE_ROOM_IMAGE,
   // A sandbox-tier room: the policy boundary is the container; the hardware
   // boundary (the VM house) belongs to the Pod, not this room. No executor —
   // inherited from the pod's house.
