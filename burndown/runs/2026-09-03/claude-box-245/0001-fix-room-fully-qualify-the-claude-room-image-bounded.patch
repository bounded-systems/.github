@@ -192,6 +192,16 @@ describe("perRepoPod", () => {
     expect(() => PodSpecSchema.parse(perRepoPod)).not.toThrow();
   });
 
+  test("every room image is registry-qualified (no docker.io short-name fallback)", () => {
+    // podman resolves a bare `name[:tag]` against docker.io/library — the
+    // claude-box#245 dead end on a fresh host. Every pinned image must carry
+    // its registry host explicitly: the first path component is a hostname
+    // (contains a `.` or a `:port`) or the literal `localhost`.
+    for (const room of perRepoPod.rooms) {
+      expect(room.image, room.name).toMatch(/^(localhost|[^/]*[.:][^/]*)\//);
+    }
+  });
+
   test("wires claude-room's beadsd + keeperd + forge-d consumes; control stays sealed", () => {
     const { resolved, diagnostics } = resolvePodDoors(perRepoPod);
     const caps = resolved
