@@ -0,0 +1,88 @@
+/**
+ * nopodman profile — a room with doors but no walls, proven without a container
+ * runtime. The allowlist door is served over a real unix socket in a private tmp
+ * run dir and driven through `call()`; a denied host reaches no `ALLOW`, an
+ * unattenuated egress door refuses to serve at all, and the profile's other
+ * refusals (world-writable dir, injecting parent) fail closed.
+ */
+import { afterEach, describe, expect, test } from "bun:test";
+import { chmodSync, mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { attenuate, attenuatesDoors, type DoorCatalog, type RoomCatalog } from "./mod.ts";
+import { call, DoorCallError } from "./protocol.ts";
+import { ALLOW_INJECTING_PARENT, nopodmanRoom, sameHostDoor } from "./profiles/nopodman.ts";
+import { allowlistDoorHandlers, allowlistDoorMethods, hasAllowlist } from "./profiles/allowlist-door.ts";
+
+const catalog: DoorCatalog = {
+  net: {
+    flag: "--net", inBox: "/run/egress.sock", env: "EGRESS_SOCK", hostDefault: "/tmp/egress.sock",
+    grants: "policed egress", use: "All egress goes through the net door.", deny: "No network here.",
+  },
+};
+const rooms: RoomCatalog = { out: { doors: ["net"], about: "egress only" } };
+
+const dirs: string[] = [];
+const freshRunDir = (): string => { const d = mkdtempSync(`${tmpdir()}/gr-nopodman-`); dirs.push(d); return d; };
+afterEach(() => { for (const d of dirs.splice(0)) rmSync(d, { recursive: true, force: true }); });
+
+describe("nopodman profile — same-host doors", () => {
+  test("the guest side is the host side, in a private run dir, and the child env points at it", () => {
+    const env = { XDG_RUNTIME_DIR: freshRunDir() };
+    const room = nopodmanRoom(rooms, catalog, "out", env, { caveats: { net: ["host=example.com"] } });
+    const [net] = room.grants;
+    expect(net!.guest).toEqual(net!.host);
+    expect(room.childEnv).toEqual({ EGRESS_SOCK: `${env.XDG_RUNTIME_DIR}/net.sock` });
+    expect(room.rulebook.join("\n")).toContain("NO WALLS");
+    expect(room.rulebook.join("\n")).toContain("RESTRICTED to: host=example.com");
+  });
+
+  test("a running broker's own env var wins over the default path", () => {
+    const g = sameHostDoor(catalog, "net", { EGRESS_SOCK: `${freshRunDir()}/live.sock` });
+    expect(g.guest).toEqual(g.host);
+    expect((g.guest as { path: string }).path.endsWith("/live.sock")).toBe(true);
+  });
+
+  test("a world-writable socket dir is refused", () => {
+    const dir = freshRunDir(); chmodSync(dir, 0o777);
+    expect(() => sameHostDoor(catalog, "net", { XDG_RUNTIME_DIR: dir })).toThrow(/world-writable/);
+  });
+
+  test("an injecting parent is refused unless the room says otherwise — and is then named", () => {
+    const env = { XDG_RUNTIME_DIR: freshRunDir(), HTTPS_PROXY: "http://gateway:1" };
+    expect(() => nopodmanRoom(rooms, catalog, "out", env)).toThrow(/injecting parent/);
+    const room = nopodmanRoom(rooms, catalog, "out", { ...env, [ALLOW_INJECTING_PARENT]: "1" });
+    expect(room.rulebook.join("\n")).toContain("http://gateway:1");
+  });
+});
+
+describe("nopodman profile — the allowlist door over a real unix socket", () => {
+  test("an egress door without a host= caveat refuses to serve", () => {
+    const bare = sameHostDoor(catalog, "net", { XDG_RUNTIME_DIR: freshRunDir() });
+    expect(hasAllowlist(bare)).toBe(false);
+    expect(() => allowlistDoorMethods(bare, () => {})).toThrow(/no host= caveat/);
+  });
+
+  test("allowed host answers, off-list host is DENIED and never logged ALLOW; narrowing narrows", async () => {
+    const env = { XDG_RUNTIME_DIR: freshRunDir() };
+    const { grants } = nopodmanRoom(rooms, catalog, "out", env, { caveats: { net: ["host=example.com,.jsr.io"] } });
+    const door = grants[0]!;
+    const log: string[] = [];
+    const server = Bun.listen({ unix: (door.host as { path: string }).path, socket: allowlistDoorHandlers(door, (l, m) => log.push(`${l} ${m}`)) });
+    try {
+      const sock = (door.guest as { path: string }).path; // what the child gets via EGRESS_SOCK
+      expect(await call(sock, "connect", { host: "example.com" })).toEqual({ host: "example.com", allowed: true });
+      expect(await call(sock, "connect", { host: "api.jsr.io" })).toEqual({ host: "api.jsr.io", allowed: true });
+      for (const host of ["evil.example.com", "github.com", ""]) {
+        const e = await call(sock, "connect", { host }).catch((x: unknown) => x);
+        expect(e).toBeInstanceOf(DoorCallError);
+        expect((e as DoorCallError).message).toMatch(/^DENIED/);
+      }
+      expect(log.filter((l) => l.startsWith("ALLOW"))).toEqual(["ALLOW example.com", "ALLOW api.jsr.io"]);
+      expect(log.filter((l) => l.startsWith("DENY")).length).toBe(3);
+    } finally { server.stop(true); }
+    // handing the door onward: a narrower child is fine; dropping the allowlist is refused
+    const child = attenuate(door, ["host=example.com"]);
+    expect(attenuatesDoors([child], [door]).ok).toBe(true);
+    expect(attenuatesDoors([{ ...door, caveats: [] }], [door]).ok).toBe(false);
+  });
+});
