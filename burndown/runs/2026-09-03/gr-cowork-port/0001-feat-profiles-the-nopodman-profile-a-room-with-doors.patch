+++ b/profiles/nopodman.ts
@@ -0,0 +1,101 @@
+/**
+ * @module
+ * profiles/nopodman.ts — the `nopodman` profile: a room with doors but no walls.
+ *
+ * A consumer's normal launch puts the guest behind WALLS (a container with no
+ * network, a user namespace) and mounts each door's socket into it. Some hosts
+ * offer no container runtime at all — a Cowork cloud sandbox is the motivating
+ * one: the guest runs on the same filesystem as its brokers, as the same uid,
+ * behind a gateway that injects credentials on the way out. This profile
+ * resolves a room for THAT substrate, and says exactly what it does not buy:
+ *
+ *   - every door's GUEST side IS its HOST side (same filesystem, no mount), so a
+ *     child reaches a broker at the path the broker actually listens on;
+ *   - socket paths live in a private run dir (`XDG_RUNTIME_DIR`, else
+ *     `$HOME/.guest-room/run`, 0700) and a world-writable dir is refused — the
+ *     fail-closed check `defaultHostSock` (mod.ts) leaves to the launch site;
+ *   - an injecting parent (`HTTPS_PROXY` set) is refused unless the room opts in
+ *     with `GUEST_ROOM_ALLOW_INJECTING_PARENT=1`, and is then NAMED in the
+ *     rulebook: a door here cannot deny reach or strip identity;
+ *   - the rulebook says in as many words that there are NO WALLS — the surface
+ *     is a default a careful child honors, not enforcement.
+ *
+ * What it does NOT do is confine. The gap list lives in
+ * docs/working-in-a-cowork-sandbox.md (§ The `nopodman` profile).
+ */
+import { statSync } from "node:fs";
+import { dirname } from "node:path";
+import {
+  attenuate, deniedDoors, deniedDoorSection, expandRoom, grantedDoorLines, resolveDoor, unix,
+  type DoorCatalog, type DoorGrant, type Env, type RoomCatalog,
+} from "../mod.ts";
+import { defaultSocketPath } from "../daemon.ts";
+
+/** Opt-in: serve a room behind a credential-injecting gateway anyway. */
+export const ALLOW_INJECTING_PARENT = "GUEST_ROOM_ALLOW_INJECTING_PARENT";
+
+/** The private run dir when `XDG_RUNTIME_DIR` is unset. Never `/tmp`. */
+export function runDir(env: Env): string {
+  return `${env.HOME ?? "/tmp"}/.guest-room/run`;
+}
+
+/** Is a credential-injecting gateway fronting this host? From inside, a set
+ *  `HTTPS_PROXY` is the only signal, so its presence is treated as injecting
+ *  (fail closed) unless the room says otherwise. */
+export function injectingParent(env: Env): { proxy?: string; allowed: boolean } {
+  const proxy = env.HTTPS_PROXY ?? env.https_proxy;
+  return { proxy: proxy || undefined, allowed: env[ALLOW_INJECTING_PARENT] === "1" };
+}
+
+/** Refuse a socket whose directory anyone can write into (a stranger could
+ *  replace the broker). A missing dir is fine — the broker creates it 0700. */
+export function assertPrivateDir(sockPath: string): void {
+  let mode: number;
+  try { mode = statSync(dirname(sockPath)).mode; } catch { return; }
+  if (mode & 0o002) throw new Error(`refusing world-writable socket dir for ${sockPath}`);
+}
+
+/** Resolve one door same-host: the broker's socket is the child's socket. The
+ *  door's own env var (`<NAME>_SOCK`) wins so an already-running broker is found. */
+export function sameHostDoor(catalog: DoorCatalog, name: string, env: Env): DoorGrant {
+  const envKey = catalog[name]?.env ?? `${name.toUpperCase().replace(/-/g, "_")}_SOCK`;
+  const path = env[envKey] ?? defaultSocketPath(name, runDir, env);
+  assertPrivateDir(path);
+  const g = resolveDoor(catalog, name, unix(path), env);
+  return { ...g, guest: g.host, env: envKey };
+}
+
+/** A room opened without walls: its grants, the env a child is launched with
+ *  (`env -i` + exactly these), and the honest rulebook. */
+export type NopodmanRoom = { grants: DoorGrant[]; childEnv: Record<string, string>; rulebook: string[] };
+
+/** Open a named room same-host. Throws (fail closed) for an unknown room, a
+ *  world-writable socket dir, or an injecting parent the room did not opt into.
+ *  `caveats` narrows doors by name (append-only, via `attenuate`). */
+export function nopodmanRoom(
+  rooms: RoomCatalog, catalog: DoorCatalog, room: string, env: Env,
+  opts: { caveats?: Record<string, string[]>; workcell?: string } = {},
+): NopodmanRoom {
+  const parent = injectingParent(env);
+  if (parent.proxy && !parent.allowed) {
+    throw new Error(`refusing to open "${room}" behind an injecting parent (${parent.proxy}); set ${ALLOW_INJECTING_PARENT}=1 to acknowledge`);
+  }
+  const grants = expandRoom(rooms, catalog, room, env)
+    .map((d) => attenuate(sameHostDoor(catalog, d.name, env), opts.caveats?.[d.name] ?? []));
+  const childEnv = Object.fromEntries(grants.map((g) => [g.env, (g.guest as { path: string }).path]));
+  const denied = deniedDoors(catalog, new Set(grants.map((g) => g.name)));
+  const workcell = opts.workcell ?? room;
+  const rulebook = [
+    `[${workcell} — capability surface for THIS launch; nopodman profile: doors, NO WALLS]`,
+    `Your authority is EXACTLY the doors listed below. This launch has NO WALLS: nothing physically stops a process here from reaching past a door, so this list is the record of what was GRANTED, not a fence. Treat a denied door as denied anyway; brokers log what they serve.`,
+    ...(parent.proxy
+      ? [`An injecting gateway fronts this host (${parent.proxy}): hosts on ITS allowlist answer as the operator regardless of any door. A door here cannot deny reach or strip identity.`]
+      : []),
+    "",
+    "GRANTED:",
+    ...grantedDoorLines(grants),
+    "",
+    ...deniedDoorSection(denied),
+  ];
+  return { grants, childEnv, rulebook };
+}
