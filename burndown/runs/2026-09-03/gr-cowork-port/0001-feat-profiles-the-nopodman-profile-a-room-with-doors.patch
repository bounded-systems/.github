+/**
+ * @module
+ * profiles/allowlist-door.ts — an egress-shaped door for the `nopodman` profile.
+ *
+ * A consumer's egress door is a forward proxy in front of a box with no NIC: the
+ * bytes pass THROUGH it, so a denied host is unreachable, full stop. Without
+ * walls there is no such chokepoint — a child can reach whatever the host can.
+ * What can still exist same-host is the DECISION: one broker holding the grant,
+ * asked `connect {host}` before a child reaches out, answering from the grant's
+ * caveats via `checkCaveats` (fail closed), and logging every verdict.
+ *
+ * This is therefore a decision oracle, not a proxy — a stand-in that keeps the
+ * policy and the audit trail while the substrate cannot enforce them. It is
+ * named as such in docs/working-in-a-cowork-sandbox.md (gap G2), so the rulebook
+ * cannot claim a wall this door does not provide.
+ *
+ * Grammar (the broker's, not the engine's): `host=<a>,<b>,.<suffix>` — an OR-set
+ * of exact hosts, a leading dot matching the apex and any subdomain. A door with
+ * NO `host=` caveat is refused outright: an egress door without an allowlist is
+ * a hole, and this profile has no wall behind it to fall back on.
+ */
+import { type CaveatVerifiers, type DoorGrant, checkCaveats, parseCaveat } from "../mod.ts";
+import { type MethodRegistry, createDoorHandlers } from "../protocol.ts";
+
+/** The request context a `host=` caveat is checked against. */
+export type ConnectContext = { host: string };
+
+/** Exact host, or `.suffix` (apex + any subdomain). Case-insensitive. */
+export function matchesHost(host: string, pattern: string): boolean {
+  const h = host.toLowerCase();
+  const p = pattern.toLowerCase();
+  return p.startsWith(".") ? h === p.slice(1) || h.endsWith(p) : h === p;
+}
+
+/** The one caveat key this door interprets. */
+export const hostVerifiers: CaveatVerifiers<ConnectContext> = {
+  host: (value, ctx) => value.split(",").map((s) => s.trim()).filter(Boolean).some((p) => matchesHost(ctx.host, p)),
+};
+
+/** Does the grant carry at least one `host=` caveat? Anything else is a hole. */
+export function hasAllowlist(grant: DoorGrant): boolean {
+  return (grant.caveats ?? []).some((c) => parseCaveat(c)?.key === "host");
+}
+
+type Log = (level: "INFO" | "ERR" | "ALLOW" | "DENY" | "WARN", msg: string) => void;
+
+/** `connect {host}` → `{host, allowed: true}`, or throws `DENIED …` (the client
+ *  sees a `HANDLER_ERROR` whose message names the caveat and reason). */
+export function allowlistDoorMethods(grant: DoorGrant, log: Log): MethodRegistry {
+  if (!hasAllowlist(grant)) throw new Error(`door "${grant.name}" has no host= caveat; refusing to serve an unbounded egress door`);
+  return {
+    connect(params) {
+      const host = String(params.host ?? "").trim().toLowerCase();
+      const verdict = host ? checkCaveats(grant, { host }, hostVerifiers) : { ok: false as const, caveat: "host", reason: "unsatisfied" as const };
+      if (!verdict.ok) {
+        log("DENY", `${host || "?"} (${verdict.caveat}: ${verdict.reason})`);
+        throw new Error(`DENIED ${host || "?"}: ${verdict.caveat} ${verdict.reason}`);
+      }
+      log("ALLOW", host);
+      return { host, allowed: true };
+    },
+  };
+}
+
+/** Socket handlers for `Bun.listen({ unix: <grant.host path>, socket })`. Unix
+ *  only: the profile never leaves the filesystem, so no wire auth is required. */
+export function allowlistDoorHandlers(grant: DoorGrant, log: Log): ReturnType<typeof createDoorHandlers<{ buffer: string }>> {
+  return createDoorHandlers(grant.name, allowlistDoorMethods(grant, log), log);
+}
