 import { CHROMA_REF, CHROMATIC_THRESHOLD } from "./constants.ts";
-import type { BrandConfig } from "./config.ts";
+import { type BrandConfig, parseFontStack } from "./config.ts";
+import { type FontFamily, type GenericFontFamily } from "./font.ts";
 
 export interface Atom { cas: string; value: { $type: "CSSOKLCH"; l: number; c: number; h: number; alpha: number }; l: number; c: number; h: number; Y: number }
 
@@ -41,3 +42,13 @@ export function deriveRoles(atoms: Atom[], brand: BrandConfig): Record<Role, Ato
   }
   return roles;
 }
+
+/** The brand's font-family token — THE single source for `font-family`: the embedded faces first,
+ * then the brand's fallback stack (the zero-load system stack by default). A typed FontFamily
+ * (font.ts) that both emitters serialize; nothing else may name a typeface. */
+export function deriveFontFamily(brand: BrandConfig): FontFamily {
+  const tail = parseFontStack(brand.font);
+  const stack = [...new Set([...brand.fontFaces.map((f) => f.family), ...tail])];
+  const faces = brand.fontFaces.length ? ` Embedded: ${brand.fontFaces.map((f) => f.family).join(", ")} (@font-face, data: URI); the rest is the fallback tail.` : " No embedded face — the zero-load system stack.";
+  return { $type: "font-family", $value: stack, $generic: tail.at(-1) as GenericFontFamily, $reifiesTo: "CSSStyleValue", $description: `Font stack: ${stack.join(", ")}.${faces}` };
+}
