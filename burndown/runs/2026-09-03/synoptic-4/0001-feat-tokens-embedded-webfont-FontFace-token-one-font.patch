   measure: z.number().max(80).default(66),
   /** the PREFERENCE layer, pushed to the config: per-role decisions (targetL / chroma / field / …)
@@ -26,6 +31,11 @@ export const BrandConfig = z.object({
 });
 export type BrandConfig = z.infer<typeof BrandConfig>;
 
+/** Split a CSS font-family list into its family names (quotes stripped, whitespace trimmed). */
+export function parseFontStack(stack: string): string[] {
+  return stack.split(",").map((f) => f.trim().replace(/^(["'])(.*)\1$/, "$2")).filter((f) => f.length > 0);
+}
