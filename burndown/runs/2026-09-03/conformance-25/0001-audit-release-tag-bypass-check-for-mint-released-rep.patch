diff --git a/scripts/audit/release-tags-lib.ts b/scripts/audit/release-tags-lib.ts
new file mode 100644
index 0000000..6031057
--- /dev/null
+++ b/scripts/audit/release-tags-lib.ts
@@ -0,0 +1,330 @@
+/**
+ * release-tags-lib.ts — pure logic for the release-tag bypass audit
+ * (scripts/audit/release-tags.ts). No I/O here, so it is unit-testable against
+ * fixture JSON of the GitHub ruleset API shape (release-tags_test.ts).
+ *
+ * The contract (conformance#25, implementing trellis#34): a repo that releases
+ * via mint pushes a `v*` tag, and its release workflows fire on that push. If a
+ * ruleset restricts ref creation on `refs/tags/*` and grants the release
+ * identity no bypass, `git push origin v1.2.3` dies with `GH013 creations
+ * restricted` (or the Git-DB API returns 422) — JSR still publishes through CI
+ * dispatch, but the GitHub Release, binaries and provenance never appear. This
+ * check surfaces that as a `repo-config` violation at the gate instead.
+ */
+
+// --- GitHub ruleset API shape (the subset this audit reads) -----------------
+//
+// GET /repos/{o}/{r}/rulesets?targets=tag&includes_parents=true  → RulesetSummary[]
+// GET /repos/{o}/{r}/rulesets/{id}?includes_parents=true         → Ruleset
+//
+// `bypass_actors` is only present when the token has WRITE access to the
+// ruleset (org admin for org rulesets, enterprise admin for enterprise ones).
+// Absent ≠ empty: absent means "not visible", empty means "nobody bypasses".
+
+export type BypassActor = {
+  actor_id: number | null;
+  actor_type:
+    | "Integration"
+    | "OrganizationAdmin"
+    | "RepositoryRole"
+    | "Team"
+    | "DeployKey"
+    | "EnterpriseOwner";
+  bypass_mode: "always" | "pull_request";
+};
+
+export type RulesetSummary = {
+  id: number;
+  name: string;
+  target?: "branch" | "tag" | "push" | "repository";
+  source_type: "Repository" | "Organization" | "Enterprise";
+  source: string;
+  enforcement: "active" | "evaluate" | "disabled";
+};
+
+export type Ruleset = RulesetSummary & {
+  bypass_actors?: BypassActor[];
+  conditions?: {
+    ref_name?: { include?: string[]; exclude?: string[] };
+    repository_name?: { include?: string[]; exclude?: string[] };
+  };
+  rules?: Array<{ type: string; parameters?: unknown }>;
+};
+
+// --- release identity -------------------------------------------------------
+//
+// trellis#34 has not yet settled WHERE a repo declares its release identity, so
+// the audit takes it as an argument. Until one is declared, any `always` bypass
+// actor on the restricting ruleset counts as a tag-creation path (and is
+// listed as evidence so a reviewer can judge whether it is the right one).
+
+export type ReleaseActor =
+  | { kind: "any" }
+  | { kind: "actor"; actor_type: BypassActor["actor_type"]; actor_id: number }
+  | { kind: "org-admin" };
+
+// The GitHub Actions app — the identity behind GITHUB_TOKEN, which is what
+// mint's release-cut.yml (workflow_dispatch cut) pushes the tag with.
+export const GITHUB_ACTIONS_APP_ID = 15368;
+
+/** Parse `--release-actor=` values: any | github-actions | org-admin | <type>:<id>. */
+export function parseReleaseActor(spec: string | undefined): ReleaseActor {
+  if (!spec || spec === "any") return { kind: "any" };
+  if (spec === "github-actions") {
+    return {
+      kind: "actor",
+      actor_type: "Integration",
+      actor_id: GITHUB_ACTIONS_APP_ID,
+    };
+  }
+  if (spec === "org-admin") return { kind: "org-admin" };
+  const m = /^(integration|team|role|deploy-key):(\d+)$/i.exec(spec);
+  if (!m) {
+    throw new Error(
+      `--release-actor: expected any | github-actions | org-admin | integration:<id> | team:<id> | role:<id> | deploy-key:<id>, got "${spec}"`,
+    );
+  }
+  const actor_type = {
+    integration: "Integration",
+    team: "Team",
+    role: "RepositoryRole",
+    "deploy-key": "DeployKey",
+  }[m[1].toLowerCase()] as BypassActor["actor_type"];
+  return { kind: "actor", actor_type, actor_id: Number(m[2]) };
+}
+
+export function actorMatches(a: BypassActor, want: ReleaseActor): boolean {
+  if (a.bypass_mode !== "always") return false; // pull_request bypass can't push a tag
+  switch (want.kind) {
+    case "any":
+      return true;
+    case "org-admin":
+      return a.actor_type === "OrganizationAdmin" ||
+        a.actor_type === "EnterpriseOwner";
+    case "actor":
+      return a.actor_type === want.actor_type && a.actor_id === want.actor_id;
+  }
+}
+
+export const describeActor = (a: BypassActor): string =>
+  `${a.actor_type}${
+    a.actor_id === null ? "" : `#${a.actor_id}`
+  }(${a.bypass_mode})`;
+
+// --- ref-name pattern matching ---------------------------------------------
+//
+// GitHub ruleset ref_name patterns are fnmatch-style: `*` matches within one
+// path segment, `**` crosses segments, plus the `~ALL` / `~DEFAULT_BRANCH`
+// shorthands. Tags are matched as `refs/tags/<name>`.
+
+export function refPatternToRegExp(pattern: string): RegExp {
+  let re = "";
+  for (let i = 0; i < pattern.length; i++) {
+    const c = pattern[i];
+    if (c === "*") {
+      if (pattern[i + 1] === "*") {
+        re += ".*";
+        i++;
+      } else re += "[^/]*";
+    } else if (c === "?") re += "[^/]";
+    else re += c.replace(/[.+^${}()|[\]\\]/g, "\\$&");
+  }
+  return new RegExp(`^${re}$`);
+}
+
+export function refMatches(ref: string, pattern: string): boolean {
+  if (pattern === "~ALL") return true;
+  if (pattern === "~DEFAULT_BRANCH") return false; // never a tag
+  return refPatternToRegExp(pattern).test(ref);
+}
+
+/** Does this ruleset's ref_name condition cover the given fully-qualified ref? */
+export function conditionCovers(rs: Ruleset, ref: string): boolean {
+  const include = rs.conditions?.ref_name?.include ?? [];
+  const exclude = rs.conditions?.ref_name?.exclude ?? [];
+  if (!include.some((p) => refMatches(ref, p))) return false;
+  return !exclude.some((p) => refMatches(ref, p));
+}
+
+/** A ruleset that actively restricts creating `v*` tags. */
+export function restrictsTagCreation(
+  rs: Ruleset,
+  sampleTag = "refs/tags/v1.0.0",
+): boolean {
+  if (rs.enforcement !== "active") return false;
+  if (rs.target && rs.target !== "tag") return false;
+  if (!(rs.rules ?? []).some((r) => r.type === "creation")) return false;
+  return conditionCovers(rs, sampleTag);
+}
+
+// --- mint-released detection -----------------------------------------------
+//
+// A repo is mint-released when a workflow fires on `push: tags: [v*]` (the
+// shape mint prescribes for release.yml / publish-jsr.yml), or
+// it carries mint's `.release/` intents directory, or it calls mint's
+// release-cut reusable workflow.
+
+export type RepoFile = { path: string; content?: string };
+
+// `tags: ["v*"]` / `tags: [v*]` / `tags:\n  - "v*"` — under a `push:` trigger.
+const TAG_TRIGGER_INLINE = /^\s*tags:\s*\[\s*['"]?v\*['"]?/m;
+const TAG_TRIGGER_LIST =
+  /^\s*tags:\s*\n(?:\s*-\s*['"]?[^\n]*\n)*?\s*-\s*['"]?v\*['"]?/m;
+const PUSH_TRIGGER = /^\s*push:\s*$/m;
+// Line-anchored so a commented-out example (mint's own header) doesn't count.
+const RELEASE_CUT =
+  /^\s*-?\s*uses:\s*['"]?bounded-systems\/mint\/\.github\/workflows\/release-cut\.yml/m;
+
+export type MintClassification = { mintReleased: boolean; evidence: string[] };
+
+export function classifyMintReleased(files: RepoFile[]): MintClassification {
+  const evidence: string[] = [];
+  if (files.some((f) => /^\.release\/[^/]+$/.test(f.path))) {
+    evidence.push(".release/ (mint intents)");
+  }
+  for (const f of files) {
+    if (!/^\.github\/workflows\/[^/]+\.ya?ml$/.test(f.path) || !f.content) {
+      continue;
+    }
+    const c = f.content;
+    if (
+      PUSH_TRIGGER.test(c) &&
+      (TAG_TRIGGER_INLINE.test(c) || TAG_TRIGGER_LIST.test(c))
+    ) {
+      evidence.push(`${f.path} (on: push: tags: v*)`);
+    } else if (RELEASE_CUT.test(c)) {
+      evidence.push(`${f.path} (calls mint release-cut.yml)`);
+    }
+  }
+  return { mintReleased: evidence.length > 0, evidence };
+}
+
+// --- verdict ---------------------------------------------------------------
+
+export type Verdict = "PASS" | "FAIL" | "UNKNOWN" | "SKIP";
+
+export type RepoResult = {
+  repo: string;
+  mintReleased: boolean;
+  restricted: boolean;
+  bypass: "yes" | "no" | "n/a" | "unknown";
+  verdict: Verdict;
+  evidence: string[];
+};
+
+const rulesetRef = (rs: RulesetSummary) =>
+  `${rs.source_type.toLowerCase()} ruleset "${rs.name}" (#${rs.id}, ${rs.source})`;
+
+/**
+ * Score one repo.
+ *   SKIP    — not mint-released; the contract does not apply.
+ *   PASS    — no active tag-creation restriction covers refs/tags/v*, OR every
+ *             restricting ruleset grants the release identity an `always` bypass.
+ *   FAIL    — a restricting ruleset is visible and grants no matching bypass.
+ *   UNKNOWN — a restricting ruleset's bypass_actors are not readable with this
+ *             token (typical for enterprise-level rulesets), so the verdict
+ *             cannot be proven either way.
+ */
+export function scoreRepo(
+  repo: string,
+  files: RepoFile[],
+  rulesets: Ruleset[],
+  want: ReleaseActor,
+): RepoResult {
+  const mint = classifyMintReleased(files);
+  if (!mint.mintReleased) {
+    return {
+      repo,
+      mintReleased: false,
+      restricted: false,
+      bypass: "n/a",
+      verdict: "SKIP",
+      evidence: ["no v* tag-triggered workflow / .release/"],
+    };
+  }
+  const evidence = [...mint.evidence];
+  const restricting = rulesets.filter((rs) => restrictsTagCreation(rs));
+  if (restricting.length === 0) {
+    evidence.push(
+      rulesets.length === 0
+        ? "no tag rulesets apply"
+        : `no active creation rule covers refs/tags/v* (${
+          rulesets.map((r) => `#${r.id}`).join(", ")
+        })`,
+    );
+    return {
+      repo,
+      mintReleased: true,
+      restricted: false,
+      bypass: "n/a",
+      verdict: "PASS",
+      evidence,
+    };
+  }
+  let verdict: Verdict = "PASS";
+  let bypass: RepoResult["bypass"] = "yes";
+  for (const rs of restricting) {
+    if (rs.bypass_actors === undefined) {
+      evidence.push(
+        `${
+          rulesetRef(rs)
+        }: restricts creation; bypass_actors NOT VISIBLE to this token`,
+      );
+      if (verdict !== "FAIL") {
+        verdict = "UNKNOWN";
+        bypass = "unknown";
+      }
+      continue;
+    }
+    const ok = rs.bypass_actors.filter((a) => actorMatches(a, want));
+    const all = rs.bypass_actors.map(describeActor).join(", ") || "none";
+    if (ok.length > 0) {
+      evidence.push(
+        `${rulesetRef(rs)}: restricts creation; release-identity bypass via ${
+          ok.map(describeActor).join(", ")
+        }`,
+      );
+    } else {
+      evidence.push(
+        `${
+          rulesetRef(rs)
+        }: restricts creation; NO release-identity bypass (actors: ${all})`,
+      );
+      verdict = "FAIL";
+      bypass = "no";
+    }
+  }
+  return {
+    repo,
+    mintReleased: true,
+    restricted: true,
+    bypass,
+    verdict,
+    evidence,
+  };
+}
+
+// --- report ----------------------------------------------------------------
+
+export function renderTable(results: RepoResult[]): string {
+  const rows = [
+    "| repo | mint-released | tag creation restricted | release-identity bypass | verdict | evidence |",
+    "| --- | :-: | :-: | :-: | :-: | --- |",
+  ];
+  for (const r of results) {
+    rows.push(
+      `| ${r.repo} | ${r.mintReleased ? "yes" : "no"} | ${
+        r.mintReleased ? (r.restricted ? "yes" : "no") : "-"
+      } | ${r.bypass} | ${r.verdict} | ${
+        r.evidence.join("; ").replace(/\|/g, "\\|")
+      } |`,
+    );
+  }
+  return rows.join("\n");
+}
+
+export function summarize(results: RepoResult[]): Record<Verdict, number> {
+  const s: Record<Verdict, number> = { PASS: 0, FAIL: 0, UNKNOWN: 0, SKIP: 0 };
+  for (const r of results) s[r.verdict]++;
+  return s;
+}
