+Deno.test("scoreRepo: bypass_actors absent (token can't read them) → UNKNOWN, not PASS", () => {
+  const r = scoreRepo(
+    "mint",
+    REPOS.mint_tag_push,
+    [RS.bypass_not_visible],
+    ANY,
+  );
+  assertEquals(r.verdict, "UNKNOWN");
+  assertEquals(r.bypass, "unknown");
+  assert(r.evidence.some((e) => e.includes("NOT VISIBLE")));
+  // ...but a visible FAIL on another ruleset outranks UNKNOWN
+  const both = scoreRepo(
+    "mint",
