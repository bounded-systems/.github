+Deno.test("renderTable + summarize: one markdown row per repo, evidence paths kept", () => {
+  const results = [
+    scoreRepo("mint", REPOS.mint_tag_push, [RS.enterprise_no_bypass], ANY),
+    scoreRepo("drift-gate", REPOS.mint_list_form, [
+      RS.enterprise_actions_bypass,
+    ], ANY),
+    scoreRepo("docs", REPOS.not_released, [], ANY),
+  ];
+  const table = renderTable(results);
+  const lines = table.split("\n");
+  assertEquals(lines.length, 2 + results.length);
+  assert(lines[2].startsWith("| mint | yes | yes | no | FAIL | .release/"));
+  assert(
+    lines[3].startsWith(
+      "| drift-gate | yes | yes | yes | PASS | .github/workflows/publish-jsr.yml",
+    ),
+  );
+  assert(lines[4].startsWith("| docs | no | - | n/a | SKIP |"));
+  assertEquals(summarize(results), { PASS: 1, FAIL: 1, UNKNOWN: 0, SKIP: 1 });
+});
