new file mode 100644
index 0000000..949fa19
--- /dev/null
+++ b/scripts/audit/release-tags.ts
@@ -0,0 +1,189 @@
+#!/usr/bin/env -S deno run --allow-run=gh --allow-env
+/**
+ * release-tags.ts — org-wide, REPORT-ONLY release-tag bypass audit
+ * (conformance#25, implementing trellis#34).
+ *
+ * A repo that releases via mint pushes a `v*` tag (release.yml / publish-jsr.yml
+ * fire on `push: tags: [v*]`). A ruleset that restricts ref
+ * creation on `refs/tags/*` with no bypass for the release identity silently
+ * breaks that: `git push origin v1.2.3` → `GH013 creations restricted` (or 422
+ * from the Git-DB API), JSR still publishes via CI dispatch, but the GitHub
+ * Release, binaries and provenance never land. This audit turns that into a
+ * `repo-config` finding at the gate instead of at `git push`.
+ *
+ * Per repo:
+ *   mint-released?  — a `.github/workflows/*.yml` with `on: push: tags: [v*]`,
+ *                     a `.release/` intents dir, or a call to mint's
+ *                     release-cut.yml (tree + raw contents, like actions.ts).
+ *   restricted?     — GET repos/{o}/{r}/rulesets?targets=tag&includes_parents=true
+ *                     then GET repos/{o}/{r}/rulesets/{id}: any ACTIVE ruleset
+ *                     whose ref_name condition covers refs/tags/v* and carries
+ *                     a `creation` rule.
+ *   bypass?         — a `bypass_actors` entry with bypass_mode `always` for the
+ *                     release identity (--release-actor; default: any actor,
+ *                     because trellis#34 has not settled where a repo declares
+ *                     its release identity — the actors are printed as evidence).
+ *   verdict         — SKIP (not mint-released) | PASS | FAIL | UNKNOWN (the
+ *                     restricting ruleset's bypass_actors are not visible).
+ *
+ * Token posture: `gh repo list` + trees/contents read public repos with the
+ * default token, and the rulesets LIST is readable with `contents: read` — but
+ * `bypass_actors` is only returned when the token has WRITE access to the
+ * ruleset: an org-admin token (`admin:org`, or the org-admin App scripts/audit.mjs
+ * uses) for org rulesets, and enterprise ownership for enterprise-level ones.
+ * Without it every restricted repo scores UNKNOWN, never a false PASS.
+ *
+ * Report-only: exits 0 (like actions.ts). `--strict` exits 1 on any FAIL;
+ * `--strict --fail-unknown` also on UNKNOWN. `--repo=<name>` limits the run.
+ *
+ *   deno task audit:release-tags
+ *   deno task audit:release-tags -- --release-actor=github-actions
+ *   deno task audit:release-tags -- --repo=mint --release-actor=integration:15368
+ */
+import {
+  parseReleaseActor,
+  renderTable,
+  type RepoFile,
+  type RepoResult,
+  type Ruleset,
+  type RulesetSummary,
+  scoreRepo,
+  summarize,
+} from "./release-tags-lib.ts";
+
+const ORG = Deno.env.get("ORG") || "bounded-systems";
+
+function arg(name: string): string | undefined {
+  const hit = Deno.args.find((a) => a.startsWith(`--${name}=`));
+  return hit?.slice(name.length + 3);
+}
+
+async function gh(path: string, raw = false): Promise<string> {
+  const args = ["api", path];
+  if (raw) args.push("-H", "Accept: application/vnd.github.raw");
+  const cmd = new Deno.Command("gh", { args, stdout: "piped", stderr: "null" });
+  const { code, stdout } = await cmd.output();
+  return code === 0 ? new TextDecoder().decode(stdout) : "";
+}
+async function ghList(args: string[]): Promise<string> {
+  const cmd = new Deno.Command("gh", { args, stdout: "piped", stderr: "null" });
+  const { code, stdout } = await cmd.output();
+  return code === 0 ? new TextDecoder().decode(stdout) : "";
+}
+async function pool<T, R>(
+  items: T[],
+  limit: number,
+  fn: (t: T) => Promise<R>,
+): Promise<R[]> {
+  const res: R[] = new Array(items.length);
+  let i = 0;
+  await Promise.all(
+    Array.from({ length: Math.min(limit, items.length) }, async () => {
+      while (i < items.length) {
+        const idx = i++;
+        res[idx] = await fn(items[idx]);
+      }
+    }),
+  );
+  return res;
+}
+
+// Workflow files (with contents) + the .release/ listing, enough to classify.
+async function repoFiles(repo: string): Promise<RepoFile[]> {
+  const treeRaw = await gh(`repos/${ORG}/${repo}/git/trees/HEAD?recursive=1`);
+  if (!treeRaw) return [];
+  const paths: string[] = (JSON.parse(treeRaw).tree ?? [])
+    .filter((n: { type: string; path: string }) =>
+      n.type === "blob" &&
+      (/^\.github\/workflows\/[^/]+\.ya?ml$/.test(n.path) ||
+        /^\.release\/[^/]+$/.test(n.path))
+    )
+    .map((n: { path: string }) => n.path);
+  const out: RepoFile[] = [];
+  for (const path of paths) {
+    if (path.startsWith(".github/workflows/")) {
+      out.push({
+        path,
+        content: await gh(`repos/${ORG}/${repo}/contents/${path}`, true),
+      });
+    } else out.push({ path });
+  }
+  return out;
+}
+
+// Tag rulesets in effect for the repo (repo + org + enterprise), with details
+// where the token can read them. A detail fetch that fails leaves the summary
+// as-is: no `rules`/`bypass_actors`, which scoreRepo reports as not visible.
+async function tagRulesets(repo: string): Promise<Ruleset[]> {
+  const listRaw = await gh(
+    `repos/${ORG}/${repo}/rulesets?targets=tag&includes_parents=true`,
+  );
+  if (!listRaw) return [];
+  const summaries: RulesetSummary[] = JSON.parse(listRaw);
+  const out: Ruleset[] = [];
+  for (const s of summaries) {
+    const detailRaw = await gh(
+      `repos/${ORG}/${repo}/rulesets/${s.id}?includes_parents=true`,
+    );
+    if (!detailRaw) {
+      // Unreadable detail: assume it restricts (enforcement + tag target are
+      // known from the summary) so it surfaces as UNKNOWN, not a silent PASS.
+      out.push({
+        ...s,
+        rules: [{ type: "creation" }],
+        conditions: { ref_name: { include: ["~ALL"], exclude: [] } },
+      });
+      continue;
+    }
+    out.push({ ...s, ...JSON.parse(detailRaw) });
+  }
+  return out;
+}
+
+// --- run ---
+const want = parseReleaseActor(arg("release-actor"));
+const only = arg("repo");
+const names: string[] = only ? [only] : JSON.parse(
+  await ghList([
+    "repo",
+    "list",
+    ORG,
+    "--limit",
+    "300",
+    "--no-archived",
+    "--json",
+    "name",
+  ]),
+).map((r: { name: string }) => r.name).sort();
+
+const results: RepoResult[] = await pool(names, 10, async (repo) => {
+  const files = await repoFiles(repo);
+  // Only mint-released repos need the ruleset round-trips.
+  const probe = scoreRepo(repo, files, [], want);
+  if (probe.verdict === "SKIP") return probe;
+  return scoreRepo(repo, files, await tagRulesets(repo), want);
+});
+
+const p = (s: string) => console.log(s);
+p(`\n=== release-tag bypass audit (report-only) — ${names.length} repos, release identity: ${
+  arg("release-actor") ?? "any"
+} ===\n`);
+p(renderTable(results));
+const s = summarize(results);
+p(
+  `\nSummary: PASS=${s.PASS} FAIL=${s.FAIL} UNKNOWN=${s.UNKNOWN} SKIP=${s.SKIP} (mint-released: ${
+    results.filter((r) => r.mintReleased).length
+  })`,
+);
+if (s.UNKNOWN > 0) {
+  p(
+    "UNKNOWN = the restricting ruleset's bypass_actors are not visible to GH_TOKEN; rerun with an org-admin (or enterprise-owner) token.",
+  );
+}
+
+if (Deno.args.includes("--strict")) {
+  const hard = s.FAIL + (Deno.args.includes("--fail-unknown") ? s.UNKNOWN : 0);
+  p(`\n--strict: ${hard} violations.`);
+  Deno.exit(hard > 0 ? 1 : 0);
+}
+p("Report-only: exit 0.");
diff --git a/scripts/audit/release-tags_test.ts b/scripts/audit/release-tags_test.ts
new file mode 100644
index 0000000..ec87a08
--- /dev/null
+++ b/scripts/audit/release-tags_test.ts
@@ -0,0 +1,228 @@
+// Unit tests for the release-tag bypass audit (conformance#25), against fixture
+// JSON in the GitHub ruleset API shape (fixtures/rulesets.json) and fixture repo
+// trees (fixtures/repos.json). No network; `deno test scripts/audit/`.
+// node:assert (built into Deno) so the suite adds no dependency — CI's deno
+// cache/lock stay untouched.
+import {
+  deepStrictEqual as assertEquals,
+  ok as assert,
+  throws as assertThrows,
+} from "node:assert";
+import {
+  classifyMintReleased,
+  conditionCovers,
+  GITHUB_ACTIONS_APP_ID,
+  parseReleaseActor,
+  refMatches,
+  renderTable,
+  type RepoFile,
+  restrictsTagCreation,
+  type Ruleset,
+  scoreRepo,
+  summarize,
+} from "./release-tags-lib.ts";
+
+const here = new URL(".", import.meta.url);
+const load = <T>(f: string): T =>
+  JSON.parse(Deno.readTextFileSync(new URL(`fixtures/${f}`, here)));
+const RS = load<Record<string, Ruleset>>("rulesets.json");
+const REPOS = load<Record<string, RepoFile[]>>("repos.json");
+const ANY = parseReleaseActor(undefined);
+const ACTIONS = parseReleaseActor("github-actions");
+
+Deno.test("refMatches: fnmatch semantics of ruleset ref_name patterns", () => {
+  assert(refMatches("refs/tags/v1.0.0", "refs/tags/*"));
+  assert(refMatches("refs/tags/v1.0.0", "refs/tags/v*"));
+  assert(refMatches("refs/tags/v1.0.0", "~ALL"));
+  assert(!refMatches("refs/tags/v1.0.0", "~DEFAULT_BRANCH"));
+  assert(!refMatches("refs/tags/v1.0.0", "refs/heads/*"));
+  assert(!refMatches("refs/tags/v1.0.0", "refs/tags/release-*"));
+  // `*` stays within a segment; `**` crosses them
+  assert(!refMatches("refs/tags/release/v1", "refs/tags/*"));
+  assert(refMatches("refs/tags/release/v1", "refs/tags/**"));
+  // regex metacharacters in a pattern are literal
+  assert(!refMatches("refs/tags/v1x0", "refs/tags/v1.0"));
+});
+
+Deno.test("restrictsTagCreation: active + creation rule + covering condition", () => {
+  assert(restrictsTagCreation(RS.enterprise_no_bypass));
+  assert(restrictsTagCreation(RS.enterprise_actions_bypass));
+  assert(restrictsTagCreation(RS.org_admin_pr_only));
+  assert(restrictsTagCreation(RS.bypass_not_visible));
+  assert(!restrictsTagCreation(RS.disabled), "disabled enforcement");
+  assert(!restrictsTagCreation(RS.excludes_v), "v* excluded");
+  assert(!restrictsTagCreation(RS.deletion_only), "no creation rule");
+  assert(!conditionCovers(RS.excludes_v, "refs/tags/v2.0.0"));
+  assert(conditionCovers(RS.excludes_v, "refs/tags/nightly"));
+});
+
+Deno.test("classifyMintReleased: tag-push, list form, release-cut, none", () => {
+  const a = classifyMintReleased(REPOS.mint_tag_push);
+  assert(a.mintReleased);
+  assertEquals(a.evidence, [
+    ".release/ (mint intents)",
+    ".github/workflows/release.yml (on: push: tags: v*)",
+  ]);
+  assert(classifyMintReleased(REPOS.mint_list_form).mintReleased);
+  assertEquals(classifyMintReleased(REPOS.mint_release_cut).evidence, [
+    ".github/workflows/release-cut.yml (calls mint release-cut.yml)",
+  ]);
+  assert(!classifyMintReleased(REPOS.not_released).mintReleased);
+});
+
+Deno.test("parseReleaseActor", () => {
+  assertEquals(parseReleaseActor("any"), { kind: "any" });
+  assertEquals(ACTIONS, {
+    kind: "actor",
+    actor_type: "Integration",
+    actor_id: GITHUB_ACTIONS_APP_ID,
+  });
+  assertEquals(parseReleaseActor("team:42"), {
+    kind: "actor",
+    actor_type: "Team",
+    actor_id: 42,
+  });
+  assertEquals(parseReleaseActor("org-admin"), { kind: "org-admin" });
+  assertThrows(() => parseReleaseActor("bogus"));
+});
+
+Deno.test("scoreRepo: not mint-released → SKIP regardless of rulesets", () => {
+  const r = scoreRepo(
+    "docs",
+    REPOS.not_released,
+    [RS.enterprise_no_bypass],
+    ANY,
+  );
+  assertEquals(r.verdict, "SKIP");
+  assertEquals(r.bypass, "n/a");
+});
+
+Deno.test("scoreRepo: mint-released, no tag rulesets → PASS (unrestricted)", () => {
+  const r = scoreRepo("mint", REPOS.mint_tag_push, [], ANY);
+  assertEquals(r.verdict, "PASS");
+  assert(!r.restricted);
+  assert(r.evidence.includes("no tag rulesets apply"));
+});
+
+Deno.test("scoreRepo: only non-restricting rulesets → PASS with ids as evidence", () => {
+  const r = scoreRepo(
+    "mint",
+    REPOS.mint_tag_push,
+    [RS.disabled, RS.deletion_only, RS.excludes_v],
+    ANY,
+  );
+  assertEquals(r.verdict, "PASS");
+  assert(r.evidence.some((e) => e.includes("#9006, #9008, #9007")));
+});
+
+Deno.test("scoreRepo: restriction with empty bypass_actors → FAIL (the trellis#34 shape)", () => {
+  const r = scoreRepo(
+    "mint",
+    REPOS.mint_tag_push,
+    [RS.enterprise_no_bypass],
+    ANY,
+  );
+  assertEquals(r.verdict, "FAIL");
+  assertEquals(r.bypass, "no");
+  assert(
+    r.evidence.some((e) =>
+      e.includes(
+        'enterprise ruleset "Restrict tag creation" (#9001, bounded)',
+      ) &&
+      e.includes("NO release-identity bypass (actors: none)")
+    ),
+    r.evidence.join(" | "),
+  );
+});
+
+Deno.test("scoreRepo: pull_request-mode bypass does not count", () => {
+  const r = scoreRepo(
+    "mint",
+    REPOS.mint_list_form,
+    [RS.org_admin_pr_only],
+    ANY,
+  );
