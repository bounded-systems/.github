new file mode 100644
index 0000000..a2faa2b
--- /dev/null
+++ b/.github/workflows/release-tags-audit.yml
@@ -0,0 +1,99 @@
+name: release-tags-audit
+
+# Org-wide release-tag bypass audit (scripts/audit/release-tags.ts) — conformance#25,
+# implementing trellis#34. For every mint-released repo (a workflow on
+# `push: tags: [v*]`, a `.release/` dir, or a call to mint's release-cut.yml):
+#   restricted?  an ACTIVE ruleset with a `creation` rule covering refs/tags/v*
+#   bypass?      a bypass_actors entry (bypass_mode: always) for the release identity
+#   verdict      PASS | FAIL | UNKNOWN (bypass_actors not visible) | SKIP (not mint)
+# REPORT-ONLY for now: exits 0 (the actions-audit went report-only → --strict the
+# same way once its baseline was clean). Promote via `audit:release-tags:strict`.
+#
+# Token posture: repo enumeration, trees, contents and the rulesets LIST work with
+# the default token, but `bypass_actors` is only returned to a token with WRITE
+# access to the ruleset — an org-admin token (`admin:org`, the same App
+# scripts/audit.mjs uses) for org rulesets, enterprise ownership for the
+# enterprise-level refs/tags/* ruleset trellis#34 describes.
+#
+# Two jobs, deliberately split by credential (the open-prs.yml / actions-audit.yml
+# precedent): `pr` runs PR-modified code (release-tags.ts, deno.json are in the
+# path filter) with ONLY github.token — restricted repos score UNKNOWN there,
+# never a false PASS. `org` runs on schedule / workflow_dispatch only, from the
+# default branch, and is the only job that mints the org-admin App token
+# (vars.ORG_ADMIN_APP_ID + secrets.ORG_ADMIN_APP_PRIVATE_KEY, as open-prs.yml).
+# An admin credential is never handed to a pull_request-triggered job.
+on:
+  schedule:
+    - cron: "29 6 * * *" # daily, after actions-audit
+  workflow_dispatch:
+  pull_request:
+    paths:
+      - scripts/audit/release-tags.ts
+      - scripts/audit/release-tags-lib.ts
+      - scripts/audit/release-tags_test.ts
+      - scripts/audit/fixtures/**
+      - .github/workflows/release-tags-audit.yml
+      - deno.json
+
+permissions:
+  contents: read
+
+concurrency:
+  group: release-tags-audit-${{ github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  # PR-triggered: unit tests + the audit under the default token. No App token.
+  pr:
+    if: ${{ github.event_name == 'pull_request' }}
+    runs-on: ubuntu-latest
+    steps:
+      - uses: step-security/harden-runner@05e31511f85b41b11d1cf0ef85d0992719546e2c # v2.21.0
+        with:
+          egress-policy: audit
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - uses: denoland/setup-deno@22d081ff2d3a40755e97629de92e3bcbfa7cf2ed # v2.0.5
+        with:
+          deno-version: v2.x
+      - name: unit tests (fixture rulesets, no network)
+        run: deno task test:audit
+      - name: release-tag bypass audit (report-only, default token → UNKNOWN rows)
+        shell: bash
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          set -o pipefail
+          deno task audit:release-tags | tee -a "$GITHUB_STEP_SUMMARY"
+
+  # Scheduled / manual: default-branch code only, org-admin App token so
+  # bypass_actors are readable and rows resolve to PASS/FAIL.
+  org:
+    if: ${{ github.event_name != 'pull_request' }}
+    runs-on: ubuntu-latest
+    steps:
+      - uses: step-security/harden-runner@05e31511f85b41b11d1cf0ef85d0992719546e2c # v2.21.0
+        with:
+          egress-policy: audit
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+      - uses: denoland/setup-deno@22d081ff2d3a40755e97629de92e3bcbfa7cf2ed # v2.0.5
+        with:
+          deno-version: v2.x
+      - name: unit tests (fixture rulesets, no network)
+        run: deno task test:audit
+      - uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
+        id: app-token
+        with:
+          app-id: ${{ vars.ORG_ADMIN_APP_ID }}
+          private-key: ${{ secrets.ORG_ADMIN_APP_PRIVATE_KEY }}
+          owner: ${{ github.repository_owner }}
+      - name: release-tag bypass audit (report-only, org-admin token)
+        shell: bash
+        env:
+          GH_TOKEN: ${{ steps.app-token.outputs.token }}
+        run: |
+          set -o pipefail
+          deno task audit:release-tags | tee -a "$GITHUB_STEP_SUMMARY"
