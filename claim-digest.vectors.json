          }
        ],
        "canonical": "7:keycard\n2:27\n40:a1b2c3d4e5f60718293a4b5c6d7e8f9012345678\n",
        "digest": "8550af8657cb8d3f8398a181d698fc8b71224c162d2d150e6a9dc4454a6fd094"
      },
      {
        "name": "two bumps, in the producer's order",
