  "v2": {
    "$comment": "COMMITTED FIXTURE for bounded.claim-request.v2 — the version that binds a claim to a PATCH SET rather than to issue coordinates alone (.github#312, for the intake shape in infra#560). Same standing rule as the v1 fixture above: not regenerated by the suite, no regeneration flag, and these digests were computed by an INDEPENDENT python/hashlib implementation of the format rule before being committed, so the fixture is not the implementation agreeing with itself. `patchSets` pins the nested encoding on its own; `valid`/`invalid` pin whole v2 requests. Note the reversed-order pair: list order is part of the request, so the same two bumps in the other order are a DIFFERENT claim and MUST digest differently.",
    "format": "bounded.claim-request.v2",
    "fieldOrder": [
      "v",
      "repo",
      "issue",
      "claimant",
      "subject",
      "policy",
      "nonce",
      "issuedAt"
    ],
    "patchFieldOrder": [
      "repo",
      "pr",
      "head_sha"
    ],
    "patchSets": [
      {
